# Pooled connection. Used by the app at runtime.
# On Vercel, adding a Postgres database from the Storage tab (Neon) sets this
# automatically for every environment.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (unpooled) connection. Used only by `prisma migrate`, which needs a
# session-level connection that a transaction pooler cannot provide. Neon
# supplies this alongside DATABASE_URL; it is the same host without "-pooler".
# Referenced by prisma/schema.prisma as `directUrl` — migrations fail without it.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Point these two at a Neon *dev branch* locally, never at production. Prisma
# reads only these two names, so keeping the production strings under different
# names (PROD_DATABASE_URL, say) puts them out of reach of every prisma command.


# --- 활동 촉진 메일 (선택) -------------------------------------------------
# 아래를 비워두면 기능 전체가 조용히 쉽니다. 크론은 돌지만 "미설정"이라고
# 보고하고 아무것도 보내지 않습니다.

# Resend API 키. https://resend.com 에서 무료로 발급합니다.
# 없으면 메일을 보내지 않습니다.
RESEND_API_KEY=""

# 보내는 사람. 도메인이 없으면 비워두십시오 — Resend의 공용 주소를 씁니다.
# 본인에게 보내는 데는 충분하지만, 다른 사람에게 보내려면 도메인 인증이
# 필요합니다.
MAIL_FROM="주간결 <onboarding@resend.dev>"

# Vercel Cron이 /api/cron/nudge를 호출할 때 쓰는 인증값. Vercel이 이 이름의
# 환경변수를 발견하면 Authorization: Bearer <값> 헤더를 붙여 보냅니다.
# 설정하지 않으면 엔드포인트가 503으로 스스로를 막습니다.
# 아무 긴 난수 문자열이면 됩니다: openssl rand -base64 32
CRON_SECRET=""

# 며칠간 활동이 없으면 보낼지. 기본 3일. 다음 메일까지의 간격도 같은 값입니다.
NUDGE_AFTER_DAYS="3"

# 메일 안의 링크가 가리킬 주소. Vercel에서는 자동으로 배포 도메인을 쓰므로
# 보통 비워둡니다.
APP_URL=""
