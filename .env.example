# Pooled connection. Used by the app at runtime.
# On Vercel, adding a Postgres database from the Storage tab (Neon) sets this
# automatically for every environment.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (unpooled) connection. Used only by `prisma migrate`, which needs a
# session-level connection that a transaction pooler cannot provide. Neon
# supplies this alongside DATABASE_URL; it is the same host without "-pooler".
# Referenced by prisma/schema.prisma as `directUrl` — migrations fail without it.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Point these two at a Neon *dev branch* locally, never at production. Prisma
# reads only these two names, so keeping the production strings under different
# names (PROD_DATABASE_URL, say) puts them out of reach of every prisma command.


# --- 가입 (초대제) --------------------------------------------------------
# 가입할 때 요구할 초대 코드. 쉼표로 여러 개를 둘 수 있고, 대소문자와 앞뒤
# 공백은 무시합니다. 코드를 여러 개 두면 나중에 하나만 폐기할 수 있습니다.
#
#   INVITE_CODES="gyeol-2026-a,gyeol-2026-b"
#
# 비워두면 가입 자체가 막힙니다 — 열리는 것이 아니라 닫힙니다. 이 변수를
# 깜빡한 배포에서 아무나 가입할 수 있게 되는 것보다, 아무도 못 하게 되는 편이
# 낫습니다. 이미 계정이 있는 사람의 로그인에는 영향이 없습니다.
#
# 초대 코드는 신원 확인이 아닙니다. 코드를 가진 사람이 누구인지 증명하지
# 못하고, 남의 이메일 주소로 가입하는 것도 막지 못합니다. 진짜 해결은
# 이메일 인증이고, 그건 위의 도메인 인증이 끝나야 만들 수 있습니다.
# 그때까지 "코드를 직접 건네받은 사람만 계정이 있다"는 성질을 지킵니다.
#
# 아무 문자열이나 됩니다: openssl rand -hex 8
INVITE_CODES=""

# --- 활동 촉진 메일 (선택) -------------------------------------------------
# 아래를 비워두면 기능 전체가 조용히 쉽니다. 크론은 돌지만 "미설정"이라고
# 보고하고 아무것도 보내지 않습니다.

# Resend API 키. https://resend.com 에서 무료로 발급합니다.
# 없으면 메일을 보내지 않습니다.
RESEND_API_KEY=""

# 보내는 사람. 도메인이 없으면 비워두십시오 — Resend의 공용 주소를 씁니다.
# 그 주소는 두 가지 제약이 있습니다. Resend에 가입한 본인 주소로만 보낼 수 있고,
# 여러 사용자가 공유하는 주소라 Gmail이 스팸으로 분류할 가능성이 높습니다.
# 2026-08-20 첫 발송이 실제로 스팸함으로 갔습니다.
#
# 남에게 권하려면 도메인 인증이 사실상 필수입니다. 순서는 이렇습니다.
#   1. 도메인을 삽니다 (연 1~2만원 수준).
#   2. Resend → Domains → Add Domain 에 넣으면 DNS 레코드를 알려줍니다.
#      SPF(TXT) 한 줄, DKIM(CNAME) 세 줄. 도메인 등록처의 DNS 설정에 넣습니다.
#   3. DMARC(TXT)를 직접 추가합니다. 이름은 _dmarc, 값은 처음엔 관찰만:
#         v=DMARC1; p=none; rua=mailto:본인주소@도메인
#      2~3주 보고서를 본 뒤 p=quarantine 으로 올립니다. 처음부터 조이면
#      본인 메일이 막힙니다.
#   4. Resend에서 Verified 로 바뀌면 아래 한 줄만 바꿉니다. 코드는 그대로입니다.
#
# 본문과 조판은 이 문제와 무관합니다. 현대 필터는 발신 도메인의 인증과 평판을
# 봅니다 — 문구에서 "무료" 같은 단어를 빼는 데 시간을 쓰지 마십시오.
MAIL_FROM="주간결 <onboarding@resend.dev>"

# 답장 받을 주소 (선택). 비워두면 헤더 자체를 넣지 않습니다.
# 답장할 수 없는 발신자는 필터가 조금 불리하게 봅니다. 다만 잘못된 주소를
# 넣는 것은 없는 것보다 나쁩니다 — 실제로 읽는 주소만 넣으십시오.
MAIL_REPLY_TO=""

# Vercel Cron이 /api/cron/nudge를 호출할 때 쓰는 인증값. Vercel이 이 이름의
# 환경변수를 발견하면 Authorization: Bearer <값> 헤더를 붙여 보냅니다.
# 설정하지 않으면 엔드포인트가 503으로 스스로를 막습니다.
# 아무 긴 난수 문자열이면 됩니다: openssl rand -base64 32
CRON_SECRET=""

# 며칠간 활동이 없으면 보낼지. 기본 3일. 다음 메일까지의 간격도 같은 값입니다.
NUDGE_AFTER_DAYS="3"

# 메일 안의 링크가 가리킬 주소. Vercel에서는 자동으로 배포 도메인을 쓰므로
# 보통 비워둡니다.
APP_URL=""
