# Postgres connection string. On Vercel, adding a Postgres database from the
# Storage tab (Neon) sets this automatically for your project's environments.
# For local development, point it at the same database or another Postgres
# instance (e.g. a Neon branch, or `docker run -p 5432:5432 postgres`).
DATABASE_URL="postgresql://user:password@host:5432/dbname"
