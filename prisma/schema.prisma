generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  // Stored lower-cased and trimmed so the unique constraint actually prevents
  // "A@x.com" and "a@x.com" becoming two accounts.
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  tasks    Task[]
  sessions Session[]
}

// Opaque server-side sessions rather than a signed JWT: they can be revoked,
// they need no signing secret to configure, and the pages already query the
// database on every request so the extra lookup is close to free.
model Session {
  id        String   @id @default(cuid())
  // Only the SHA-256 of the cookie value is stored, so a leaked database
  // dump cannot be replayed as a live session.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A single Task row covers all three kinds shown in the weekly view:
// - dueDate set, weekdays null  -> dated task
// - weekdays set                -> recurring routine (dueDate ignored)
// - dueDate null, weekdays null -> floating/backlog task (미배치)
model Task {
  id          String   @id @default(cuid())
  title       String
  memo        String?
  dueDate     DateTime?
  startTime   String? // "HH:MM", null = untimed / all-day
  endTime     String?
  weekdays    String? // comma-separated 0(Sun)-6(Sat), e.g. "1,3,5"
  priority    Int      @default(0) // 0 low, 1 medium, 2 high
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  completions TaskCompletion[]

  @@index([userId])
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date        DateTime // the occurrence date this completion applies to (midnight, local day)
  completedAt DateTime @default(now())

  @@unique([taskId, date])
}
